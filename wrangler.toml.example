# Example Wrangler config for HD Events HQ (Phases 1 and 2).
# Your live config was not uploaded, so merge the marked NEW / CHANGED parts into it
# rather than replacing it. Keep your existing name, account and database IDs.

name = "hd-events-hq"                 # your existing worker name
main = "src/worker.js"                # CHANGED: the code now lives in src/
compatibility_date = "2025-10-01"     # keep your existing date

# NEW: browser code, styles and the logo, served from public/ after the sign-in check.
[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = true               # every request passes the Access check in the worker first

[vars]
ACCESS_TEAM = "your-team"             # existing
ACCESS_AUD = "your-access-aud-tag"    # existing
OWNER_EMAIL = "owner@example.com"     # existing: the only person who can edit

[[d1_databases]]                      # existing
binding = "DB"
database_name = "hd-events-hq"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "migrations"         # NEW

[[r2_buckets]]                        # NEW: daily backups
binding = "BACKUPS"
bucket_name = "hd-events-hq-backups"

[[r2_buckets]]                        # NEW: equipment photos and logos
binding = "FILES"
bucket_name = "hd-events-hq-files"

[triggers]                            # NEW: daily backup at 02:17 UTC
crons = ["17 2 * * *"]

# Optional secret for backup failure alerts (an ntfy / Slack / Discord webhook URL):
#   npx wrangler secret put ALERT_WEBHOOK
